{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sharemarket",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": { "ENVIRONMENT": "development", "TURNSTILE_SITE_KEY": "" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sharemarket-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "sharemarket-media" }],
  "env": {
    "staging": {
      "name": "sharemarket-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sharemarket-staging-db",
          "database_id": "0d8ac253-28d9-4218-8dad-f508380f0467",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "sharemarket-staging-media" }
      ]
    },
    "production": {
      "name": "sharemarket",
      "vars": { "ENVIRONMENT": "production", "TURNSTILE_SITE_KEY": "" }
    }
  }
}
